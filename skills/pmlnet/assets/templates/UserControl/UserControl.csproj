<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
          Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <Import Project="..\AVEVA.props" />

  <PropertyGroup>
    <ProjectGuid>{7A1F3C42-0C4B-4E35-9E2A-1B5D0C7A1002}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>MyCompany.E3D.Controls</RootNamespace>
    <AssemblyName>MyCompany.E3D.Controls</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="PMLNet">
      <HintPath>$(AvevaExe)PMLNet.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>

    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="DatePickerControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Include="CheckListControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Include="pml\csharpdatepicker.pmlfrm" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <Target Name="DeployToCustomFolder" AfterTargets="Build" Condition="Exists('$(DeployDir)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" ContinueOnError="true" />
    <Copy SourceFiles="@(_DebugSymbolsIntermediatePath)" DestinationFolder="$(DeployDir)" ContinueOnError="true" />
  </Target>
</Project>
